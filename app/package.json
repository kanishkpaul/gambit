{
  "name": "gambit",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "tauri": "tauri",
    "brain": "uv run --project ../brain python -m gambit_brain --dev",
    "install-app": "tauri build && rm -rf /Applications/gambit.app && mv src-tauri/target/release/bundle/macos/gambit.app /Applications/gambit.app && touch /Applications/gambit.app"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "@observablehq/plot": "^0.6.19",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "chessops": "^0.15.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.61.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
